<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardPreventCornerOverlap="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        android:orientation="vertical">

        <!-- Image / Icon Header Container -->
        <RelativeLayout
            android:id="@+id/rlImageBg"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="@color/category_green_bg">

            <ImageView
                android:id="@+id/ivProductIcon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_centerInParent="true"
                android:contentDescription="Product"
                android:src="@drawable/ic_shirt" />

            <!-- Wishlist Heart Toggle Button -->
            <ImageView
                android:id="@+id/ivWishlistHeart"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_margin="8dp"
                android:background="@drawable/bg_logo_container"
                android:clickable="true"
                android:contentDescription="Wishlist"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_heart_outline" />
        </RelativeLayout>

        <!-- Details Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvProductTitle"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Vintage Denim Jacket"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProductPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="R280"
                    android:textColor="@color/primary_green"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <TextView
                android:id="@+id/tvProductLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Clothing · Hatfield Square"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <!-- Seller Info Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSellerAvatar"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_badge_verified"
                    android:backgroundTint="#CE93D8"
                    android:gravity="center"
                    android:text="M"
                    android:textColor="@color/text_white"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSellerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Mpho S."
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/ivVerifiedShield"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="Verified"
                    android:src="@drawable/ic_verified" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
